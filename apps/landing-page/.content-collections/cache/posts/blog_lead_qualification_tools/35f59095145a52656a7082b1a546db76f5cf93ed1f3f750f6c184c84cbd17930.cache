"var Component=(()=>{var g=Object.create;var o=Object.defineProperty;var m=Object.getOwnPropertyDescriptor;var f=Object.getOwnPropertyNames;var b=Object.getPrototypeOf,y=Object.prototype.hasOwnProperty;var k=(a,i)=>()=>(i||a((i={exports:{}}).exports,i),i.exports),w=(a,i)=>{for(var t in i)o(a,t,{get:i[t],enumerable:!0})},c=(a,i,t,n)=>{if(i&&typeof i==\"object\"||typeof i==\"function\")for(let s of f(i))!y.call(a,s)&&s!==t&&o(a,s,{get:()=>i[s],enumerable:!(n=m(i,s))||n.enumerable});return a};var v=(a,i,t)=>(t=a!=null?g(b(a)):{},c(i||!a||!a.__esModule?o(t,\"default\",{value:a,enumerable:!0}):t,a)),x=a=>c(o({},\"__esModule\",{value:!0}),a);var d=k((N,h)=>{h.exports=_jsx_runtime});var q={};w(q,{default:()=>u});var e=v(d());function p(a){let i={a:\"a\",code:\"code\",h2:\"h2\",h3:\"h3\",li:\"li\",p:\"p\",span:\"span\",strong:\"strong\",ul:\"ul\",...a.components},{Cta:t,Image:n,Info:s,Typebot:l}=i;return t||r(\"Cta\",!0),n||r(\"Image\",!0),s||r(\"Info\",!0),l||r(\"Typebot\",!0),(0,e.jsxs)(e.Fragment,{children:[(0,e.jsx)(i.p,{children:\"Here's the thing about lead qualification. 67% of lost sales happen because companies never properly qualified their prospects in the first place.\"}),`\n`,(0,e.jsx)(i.p,{children:\"Most sales teams obsess over closing techniques and follow-up sequences. They're losing revenue at the very beginning of their funnel.\"}),`\n`,(0,e.jsx)(i.p,{children:\"The most successful B2B organizations have quietly shifted their focus from chasing every lead to systematically filtering.\"}),`\n`,(0,e.jsxs)(i.p,{children:[\"Modern lead qualification tools aren't just digital forms or \",(0,e.jsx)(i.a,{href:\"./how-to-create-chatbot-for-beginners\",children:\"basic chatbots\"}),\". They're sophisticated decision engines that can predict buyer intent with startling accuracy. Let's see what solutions you have.\"]}),`\n`,(0,e.jsxs)(i.h2,{id:\"typebot-the-visual-conversational-lead-qualification-platform\",children:[(0,e.jsx)(i.a,{className:\"subheading-anchor\",\